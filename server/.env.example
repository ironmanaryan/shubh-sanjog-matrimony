# Copy to .env and edit for production
# ---------------------------------------------------------------------------
# DATABASE (primary: Supabase PostgreSQL — replaces MongoDB)
# When SUPABASE_URL is set the API uses Supabase PostgreSQL as the primary
# store. Configure these from your Supabase project settings (Project URL +
# service_role secret). When unset, the API falls back to a local SQLite
# file (development only). MONGODB_URI is deprecated and will be removed.
NEXT_PUBLIC_SUPABASE_URL=https://culcgbqeengmhdlbfwuq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_hmQbZmW7ZQQL...
SUPABASE_URL=https://culcgbqeengmhdlbfwuq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Deprecated legacy MongoDB (will be removed — kept only for transition)
# MONGODB_URI=mongodb://127.0.0.1:27017/shubh-sanjog
# Optional explicit database name (otherwise taken from the URI path)
# MONGODB_DB=shubh-sanjog

# Media storage — Cloudinary (all image/photo/PDF/document uploads)
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# AUTH / SECURITY
JWT_SECRET=replace-me-with-a-real-secret
PORT=4000

# ---------------------------------------------------------------------------
# ADMIN BOOTSTRAP (PRD §4)
# These identifiers are forced to role=admin on server start so they can sign
# in with OTP and open /admin immediately. aryansadanshiv8@gmail.com is always
# an admin by default; add more below (comma-separated).
ADMIN_EMAILS=admin@shubhsanjog.com,aryansadanshiv8@gmail.com
# Phone numbers that should also be admins (optional, comma-separated)
# ADMIN_IDENTIFIERS=

# ---------------------------------------------------------------------------
# REAL OTP DELIVERY (PRD §2) — the first configured provider wins.
# Codes are hashed (never stored raw), expire in 5–10 minutes (MongoDB TTL),
# are rate-limited to 3 sends / 10 min per identifier and lock after 5 wrong
# attempts. With NO provider configured outside production the API falls back
# to the development master code (123456); production REQUIRES a provider.
OTP_TTL_MS=300000
OTP_MAX_SENDS=3

# Twilio SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Fast2SMS (India DLT route)
# FAST2SMS_API_KEY=
# FAST2SMS_SENDER_ID=FSTSMS
# FAST2SMS_TEMPLATE_ID=

# MSG91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# Nodemailer email fallback (also used for email identifiers)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_FROM="Shubh Sanjog Matrimony <no-reply@shubhsanjog.com>"

# Development master OTP override (NEVER set in production)
# DEV_MASTER_OTP=123456

# ---------------------------------------------------------------------------
# MANUAL UPI PAYMENTS (PRD §5) — no third-party gateway.
# Plans: Consultation ₹599 · Gold ₹5,100 · Premium ₹11,000.
# Customers scan the business UPI QR / pay to this UPI ID, then submit the
# UTR + payment screenshot. Admin approves in Payment Management and the
# membership (tier, validity dates, credits) is activated in Supabase PostgreSQL.
UPI_ID=shubhsanjog@upi
UPI_PAYEE_NAME=Shubh Sanjog Matrimony

# Privacy (§30): lifetime of signed document URLs, in seconds. Default 900 = 15 min.
SIGNED_URL_TTL_SECONDS=900
