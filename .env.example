# Frontend environment (Next.js) — copy to .env.local and edit.

# Express API base URL (MongoDB-backed backend)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Payments are MANUAL UPI ONLY (no payment gateway). The business UPI ID and
# payee name are served by the API from server/.env (UPI_ID / UPI_PAYEE_NAME).

# ─── Backend (server/.env) ────────────────────────────────────────────────────
# CORS: http://localhost:3000 is ALWAYS allowed. Add extra origins here as a
# comma-separated list (unlisted origins are also reflected outside production).
# CORS_ORIGIN=https://app.example.com,https://staging.example.com

# Storage resilience: if MongoDB is unreachable the API automatically falls
# back to local SQLite so auth keeps working. Set DB_STRICT=1 to fail fast in
# production instead. MONGO_CONNECT_TIMEOUT_MS tunes the probe window (10s).
