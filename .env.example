# Frontend environment (Next.js) — copy to .env.local and edit.

# Express API base URL (MongoDB-backed backend)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Payments are MANUAL UPI ONLY (no payment gateway). The business UPI ID and
# payee name are served by the API from server/.env (UPI_ID / UPI_PAYEE_NAME).
